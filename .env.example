# Bắt buộc ở production: chuỗi ngẫu nhiên >= 32 ký tự (ví dụ: openssl rand -hex 32)
APP_SECRET=
NODE_ENV=production
PORT=3000
# Tên miền công khai (dùng cho SEO canonical/sitemap và OAuth callback)
SITE_URL=https://seller-union.vn
SITE_NAME=Seller Union
DB_FILE=./data/seller-union.db
AUTO_SYNC_MINUTES=15
INITIAL_SYNC_DAYS=30
TZ_OFFSET_MINUTES=420

# Shopee Open Platform (https://open.shopee.com) — Redirect URL: {SITE_URL}/connect/shopee/callback
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Môi trường test: https://partner.test-stable.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com

# Lazada Open Platform (https://open.lazada.com) — Callback URL: {SITE_URL}/connect/lazada/callback
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_API_HOST=https://api.lazada.vn/rest

# TikTok Shop Partner Center (https://partner.tiktokshop.com) — Redirect URL: {SITE_URL}/connect/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
